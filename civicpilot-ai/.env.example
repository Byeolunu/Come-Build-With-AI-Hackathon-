# Copier ce fichier en .env puis remplacer les valeurs factices. Ne jamais committer .env.
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_remplacez_par_votre_cle
LLM_MODEL=openai/gpt-oss-120b
# Optionnel : modèle utilisé automatiquement si le principal renvoie 429 (quota / débit)
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# Optionnel : effort de raisonnement des modèles gpt-oss (low | medium | high)
LLM_REASONING_EFFORT=low
